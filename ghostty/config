# Ghostty config (organized by category)

# https://zenn.dev/fendo181/articles/2b75b12c80fe06
# https://qiita.com/koji0705/items/053b652351a5bb23d444
# https://qiita.com/genimura/items/7fad3295c4de5538d6fe
# https://note.com/electrical_cat/n/n7a3b634a2b51
# チートシート: https://qiita.com/genimura/items/7fad3295c4de5538d6fe

# --- Theme and colors ---
theme = TokyoNight
background = #3c4048
background-opacity = 0.85
unfocused-split-opacity = 0.65
minimum-contrast = 1.3
title-report = true

# --- Font ---
font-family = "Hack Nerd Font Mono"
font-size = 14
font-thicken = true

# --- Window and tabs ---
maximize = true
window-new-tab-position = current
confirm-close-surface = always
macos-titlebar-style = tabs
macos-window-shadow = true
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-padding-color = background
split-divider-color = #4b0082

# --- Cursor and input ---
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# --- Shell and working directory ---
command = zsh
shell-integration = detect
window-inherit-working-directory = true

# --- Quick terminal ---
quick-terminal-position = "right"
quick-terminal-screen = "main"
quick-terminal-size = 40%
quick-terminal-animation-duration = 0.15
keybind = "cmd+shift+t=toggle_quick_terminal"

# --- Clipboard ---
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# --- Key Buind ---
#  Opt+Enter で「下に」分割
keybind = opt+enter=new_split:down
# Opt+Shidt+Enter で「右に」分割
keybind = opt+shift+enter=new_split:right
# Opt + 矢印キー で分割した画面を「移動」
keybind = opt+left=goto_split:left
keybind = opt+right=goto_split:right
keybind = opt+up=goto_split:top
keybind = opt+down=goto_split:bottom
# Opt + Shift + 矢印キー でサイズを「調整」
keybind = opt+shift+left=resize_split:left,20
keybind = opt+shift+right=resize_split:right,20
keybind = opt+shift+up=resize_split:up,20
keybind = opt+shift+down=resize_split:down,20

# Cmd + W で現在の「ペイン（分割）」を閉じる
keybind = cmd+w=close_surface

# --- Others ---
confirm-close-surface = false
macos-secure-input-indication = true
desktop-notifications = true
